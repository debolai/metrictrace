# Copy to .env and fill in every value marked "set me".
# `make check-env` names anything missing. Never commit .env.

# --- Environment -------------------------------------------------------------
APP_ENV=local                       # local | aws
LOG_LEVEL=INFO

# --- Lake --------------------------------------------------------------------
LAKE_BUCKET=metrictrace-lake        # AWS: Terraform output
LAKE_ENDPOINT_URL=http://minio:9000 # AWS: leave empty (real S3)
MINIO_ROOT_USER=                    # set me (local only; also the MinIO S3 key)
MINIO_ROOT_PASSWORD=                # set me (local only; at least 8 characters)
AWS_REGION=us-east-1                # DuckDB and s3fs need a region even for MinIO
AWS_PROFILE=                        # AWS, laptop only; pods use IRSA

# --- AWS catalog and query engine (APP_ENV=aws only; Terraform outputs) -------
GLUE_DATABASE=
ATHENA_WORKGROUP=
ATHENA_OUTPUT_LOCATION=             # s3://...
GLUE_CRAWLER_NAME=

# --- Services ----------------------------------------------------------------
CUBE_API_URL=http://cube:4000
API_URL=http://api:8000

# --- Source data (optional: or put the Olist zip in data/raw_download/) -------
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- LLM ---------------------------------------------------------------------
LLM_PROVIDER=anthropic              # anthropic | openai  (fake: tests only, rejected on aws)
LLM_MODEL=                          # set me; never hardcoded
ANTHROPIC_API_KEY=                  # set me if LLM_PROVIDER=anthropic
OPENAI_API_KEY=                     # set me if LLM_PROVIDER=openai

# --- Service secrets (random strings, e.g. `openssl rand -hex 32`) -------------
CUBE_API_SECRET=                    # set me; signs Cube JWTs
API_BEARER_TOKEN=                   # set me; protects FastAPI

# --- Tracing (optional; off when empty) ----------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# --- Replay window -------------------------------------------------------------
SIM_START_DATE=2017-01-01
SIM_END_DATE=2018-08-31
